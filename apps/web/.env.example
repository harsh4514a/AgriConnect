# Frontend settings. NEXT_PUBLIC_* values are embedded in browser bundles; only
# put client-safe values in them. Supply production values at build and runtime.

# The real canonical site origin. Local-only example; replace with the actual
# HTTPS origin before a production build (no path, query, or trailing route).
SITE_URL=http://localhost:3000

# Public NestJS API origin. Local development only; production must use the
# actual HTTPS API origin. This value is embedded in browser bundles.
NEXT_PUBLIC_API_URL=http://localhost:3001

# Optional Google Search Console HTML meta-tag verification value. This value
# is public by design; use the code Google gives you after verifying the site.
GOOGLE_SITE_VERIFICATION=

# Firebase Web app config is public/client-safe by design. Do not place the
# Firebase Admin service account private key in this file.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_RECAPTCHA_SITE_KEY=
