# NestJS API settings. All values in this file are server-only unless marked
# PUBLIC. Copy to a private deployment environment; never commit real secrets.

# Runtime
PORT=3001
NODE_ENV=development
CORS_ORIGINS=http://localhost:3000

# PostgreSQL / Prisma (server-only)
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public

# Server-only, unique random secrets; use a different value for each key.
# Generate each with: openssl rand -base64 48
JWT_ACCESS_SECRET=replace-with-a-unique-random-secret-at-least-32-characters
JWT_REFRESH_SECRET=replace-with-a-different-random-secret-at-least-32-characters
JWT_REGISTRATION_SECRET=replace-with-another-random-secret-at-least-32-characters
JWT_ADMIN_ACCESS_SECRET=replace-with-another-random-secret-at-least-32-characters
JWT_ADMIN_REFRESH_SECRET=replace-with-another-random-secret-at-least-32-characters

# Server-only Cloudinary credentials. Images use Cloudinary secure URLs.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_MARKETPLACE_FOLDER=agriconnect/listings

# OTP provider: mock is development-only and never sends SMS. Production must
# use firebase and the Firebase Admin service account values below.
OTP_PROVIDER=mock
OTP_COUNTRY_CODE=91
OTP_LENGTH=6
OTP_EXPIRY_MINUTES=5
OTP_RESEND_COOLDOWN=30
OTP_MAX_RESENDS=3
OTP_MAX_ATTEMPTS=5
OTP_CLEANUP_MINUTES=10

# Server-only Firebase Admin service account (never use NEXT_PUBLIC_ here).
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Government market-price import (server-only API key). The resource ID is a
# public data.gov.in identifier. Set MARKET_PRICE_SYNC_ENABLED=false if no key
# is configured or if scheduled syncing is intentionally disabled.
MARKET_PRICE_SYNC_ENABLED=true
MARKET_PRICE_INITIAL_SYNC_DAYS=3
DATA_GOV_IN_API_KEY=
DATA_GOV_IN_BASE_URL=https://api.data.gov.in
DATA_GOV_IN_RESOURCE_ID=9ef84268-d588-465a-a308-a864a43d0070
DATA_GOV_IN_PAGE_SIZE=1000

# One-time admin seed inputs. Server-only; do not retain these in deployment
# runtime settings after provisioning the administrator account.
ADMIN_USERNAME=
ADMIN_PASSWORD=
