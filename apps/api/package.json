{
  "name": "@agri/api",
  "private": true,
  "version": "0.0.1",
  "type": "commonjs",
  "scripts": {
    "dev": "nest start --watch",
    "build": "nest build",
    "test": "node --test -r ts-node/register -r tsconfig-paths/register test/listings-geography.spec.ts",
    "start": "node dist/main.js",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "db:seed": "prisma db seed",
    "db:import-gujarat-geography": "ts-node --transpile-only scripts/import-gujarat-geography.ts",
    "db:localization-audit": "ts-node --transpile-only scripts/localization-inventory.ts",
    "db:migrate:deploy": "prisma migrate deploy",
    "prisma:generate": "prisma generate",
    "prisma:studio": "prisma studio",
    "format": "prettier -w .",
    "db:seed-admin": "ts-node --transpile-only prisma/seed-admin.ts",
    "db:seed-crop-guides": "ts-node --transpile-only prisma/seed-crop-guides.ts",
    "db:seed-government-schemes": "ts-node --transpile-only prisma/seed-government-schemes.ts"
  },
  "prisma": {
    "seed": "ts-node --transpile-only prisma/seed.ts"
  },
  "dependencies": {
    "@agri/domain-data": "workspace:*",
    "@nestjs/common": "^10.4.10",
    "@nestjs/config": "^3.2.3",
    "@nestjs/core": "^10.4.10",
    "@nestjs/jwt": "^10.2.0",
    "@nestjs/passport": "^10.0.3",
    "@nestjs/platform-express": "^10.4.10",
    "@nestjs/schedule": "^4.1.1",
    "@nestjs/swagger": "^7.4.2",
    "@prisma/client": "5.22.0",
    "bcryptjs": "^3.0.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "firebase": "^12.17.0",
    "firebase-admin": "^14.2.0",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@eslint/js": "9.39.0",
    "@nestjs/cli": "^10.4.9",
    "@nestjs/schematics": "^10.2.3",
    "@nestjs/testing": "^10.4.10",
    "@types/bcryptjs": "^3.0.0",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.12",
    "@types/node": "^20.14.10",
    "@types/passport-jwt": "^3.0.0",
    "eslint": "^9.8.0",
    "prisma": "^5.21.1",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.6.3",
    "typescript-eslint": "8.0.1"
  }
}
